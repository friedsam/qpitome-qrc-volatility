__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
.env
.DS_Store
*.pyc

data/legacy_classifier_branch/*
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/legacy_classifier_branch/raw/.gitkeep
!data/legacy_classifier_branch/processed/.gitkeep

# Keep bulky run artifacts and generated figures local, but version compact
# machine-readable result tables and summaries so experiments are portable.
results/runs/*
results/figures/*
!results/runs/.gitkeep
!results/figures/.gitkeep

scratch/

*.log
*.egg-info/
