flowchart TD
    A[SPY + VIX daily market data] --> B[Engineered volatility, return, range, drawdown, and VIX features]
    B --> C[Chronological train / validation / test split]
    C --> D[Train-only StandardScaler + PCA]
    D --> E[40-day rolling market window]
    E --> F[Temporal anchor selection / virtual nodes]
    F --> G[Angle encoding: PCA components to Ry or Rz-Ry rotations]
    G --> H[Fixed TFIM quantum reservoir]
    H --> I[Reservoir evolution across temporal anchors]
    I --> J[Observable expectations]
    J --> J1[Z observables]
    J --> J2[X observables]
    J --> J3[ZZ nearest-neighbor correlators]
    J1 --> K[Reservoir feature matrix]
    J2 --> K
    J3 --> K
    K --> L[Ridge readout trained on log future realized volatility]
    L --> M[exp transform]
    M --> N[future_rv_20d forecast]
    N --> O[RMSE / QLIKE / Mincer-Zarnowitz]

    P[Classical comparison floor] --> P1[Persistence]
    P --> P2[HAR / Ridge / ElasticNet]
    P --> P3[PCA-compressed ESN log-target reservoir]
    P1 --> O
    P2 --> O
    P3 --> O

    Q[Controlled QRC probes] --> Q1[qubits: 6 / 8 / 10 / 12]
    Q --> Q2[PCA dim: 6 / 8 / 10]
    Q --> Q3[anchors: 6 / 8 / 10 / full 40]
    Q --> Q4[observables: Z / Z+X / Z+X+ZZ]
    Q --> Q5[exact expectations then finite shots]
    Q1 -.-> H
    Q2 -.-> D
    Q3 -.-> F
    Q4 -.-> J
    Q5 -.-> J

    classDef data fill:#f5f5f5,stroke:#555,stroke-width:1px;
    classDef quantum fill:#e8f0ff,stroke:#2454a6,stroke-width:1.5px;
    classDef readout fill:#fff4dc,stroke:#9a6b00,stroke-width:1.5px;
    classDef metrics fill:#eaf7ea,stroke:#2e7d32,stroke-width:1.5px;
    classDef probe fill:#f8eaff,stroke:#7b1fa2,stroke-width:1px;

    class A,B,C,D,E,F data;
    class G,H,I,J,J1,J2,J3 quantum;
    class K,L,M readout;
    class N,O metrics;
    class P,P1,P2,P3,Q,Q1,Q2,Q3,Q4,Q5 probe;
